{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(node bus/say.mjs:*)",
      "Bash(node bus/round.mjs:*)",
      "Bash(node bus/outside.mjs:*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/to-bus.mjs"], "async": true }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/to-bus.mjs"], "timeout": 10 }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "(^|-)(review|outside)$",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/to-bus.mjs"], "async": true }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "(^|-)(review|outside)$",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/to-bus.mjs"], "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|WebFetch|Read",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/to-bus.mjs"], "async": true }
        ]
      }
    ]
  }
}
