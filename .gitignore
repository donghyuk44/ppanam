node_modules/
*.log

# 대화록과 라운드 기록은 각자의 것이다 — 저장소에 넣지 않는다.
teams/*/log.jsonl
teams/*/rounds.jsonl
# 산출물(teams/*/out/)은 저장소에 넣는다 — 나리 09-16(위임 136, 점검-0916 4절: 이 PC 하나에만 있던 196커밋·60파일).
# 단 화면 사진 폴더와 100KB 넘는 그림은 뺀다 — 큰 그림 목록은 tools/out-ignore.mjs 가 아래 표시 블록에 만든다.
teams/dev/out/shots/

# /design 이 조립한 캔버스 결과물. .dc.html 원본에서 다시 만들 수 있다 (2MB).
design/*.html
!design/*.dc.html
state/agents/
.claude/hooks/debug.log
.claude/hooks/payload-*.json
state/sessions.json
state/outside-sessions.json
state/approvals.jsonl
state/executor.json

# 라운드 상태는 런타임 값이다 — 워크트리·브랜치마다 갈라지고 git add/commit 이 실수로 담는다.
# 없으면 idle(round 0)로 시작하고, 번호는 log.jsonl·rounds.jsonl 의 최대값에서 이어진다 (nextRoundNumber).
teams/*/round.json
state/notifier.json
state/conductor.json
state/world.json
state/turn/
teams/*/journal/

# 화풍 참고용 외부 그림 — 저작권이 남의 것이라 저장소에 넣지 않는다
teams/*/ref/

